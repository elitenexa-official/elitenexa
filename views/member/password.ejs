<%- include('../partials/header') %>
<div class="page-title"><h1>Change password</h1></div>
<form method="post" action="/profile/password" class="card form narrow-form" id="change-password-form">
  <h3>Update your login password</h3>
  <% if (typeof error !== 'undefined') { %><div class="alert alert-err"><%= error %></div><% } %>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <!-- lets password managers associate the new password with the right login -->
  <input type="text" name="username" value="<%= user.username %>" autocomplete="username" readonly hidden aria-hidden="true">
  <label for="current_password">Current password<input type="password" id="current_password" name="current_password" required autocomplete="current-password"></label>
  <label for="new_password">New password <span class="muted small">(min <%= min %> characters)</span><input type="password" id="new_password" name="new_password" required minlength="<%= min %>" maxlength="128" autocomplete="new-password"></label>
  <label for="confirm_password">Confirm new password<input type="password" id="confirm_password" name="confirm_password" required minlength="<%= min %>" maxlength="128" autocomplete="new-password"></label>
  <p class="small muted">You will stay logged in on this device; other devices will be signed out.</p>
  <button type="submit" class="btn btn-gold">Change password</button>
  <p class="small"><a href="/profile">← Back</a></p>
</form>
<%- include('../partials/footer') %>
