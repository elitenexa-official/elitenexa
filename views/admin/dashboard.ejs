<%- include('../partials/header') %>
<div class="page-title"><div><h1>Admin dashboard</h1><p class="muted small">EliteNexa · Grow Together · Shine Together</p></div></div>
<div class="stats">
  <div class="stat"><small>Members</small><b><%= stats.members %></b><span class="small muted"><%= stats.blocked %> blocked</span></div>
  <div class="stat gold-card"><small>Paid product sales</small><b><%= inr(stats.sales) %></b></div>
  <div class="stat"><small>Commissions credited (net)</small><b><%= inr(stats.commissions) %></b></div>
  <div class="stat"><small>Pending orders</small><b><%= stats.pendingOrders %></b><a class="small" href="/admin/orders?status=pending">Review →</a></div>
  <div class="stat"><small>Wallet balances (liability)</small><b><%= inr(stats.liability) %></b></div>
  <div class="stat"><small>Pending withdrawals</small><b><%= stats.pendingWd.n %></b><span class="small muted"><%= inr(stats.pendingWd.v) %></span></div>
  <div class="stat"><small>Paid out (approved)</small><b><%= inr(stats.paidOut) %></b></div>
</div>
<div class="grid2">
  <div class="card"><div class="section-head"><h3>Recent orders</h3><a class="link small" href="/admin/orders">All →</a></div>
    <div class="table-wrap"><table class="table"><thead><tr><th>#</th><th>Member</th><th class="r">Total</th><th>Status</th></tr></thead><tbody>
    <% recentOrders.forEach(o => { %><tr><td><%= o.id %></td><td><%= o.member %></td><td class="r"><%= inr(o.total_paise) %></td><td><span class="pill <%= o.status %>"><%= o.status %></span></td></tr><% }) %>
    </tbody></table></div></div>
  <div class="card"><div class="section-head"><h3>Recent admin actions</h3><a class="link small" href="/admin/audit">Audit log →</a></div>
    <div class="table-wrap"><table class="table"><tbody>
    <% recentAudit.forEach(l => { %><tr><td class="small nowrap"><%= fmtDate(l.created_at) %></td><td><b><%= l.action.replace(/_/g,' ') %></b><% if (l.target) { %> · <%= l.target %><% } %><br><span class="small muted"><%= (l.details||'').slice(0,120) %></span></td></tr><% }) %>
    </tbody></table></div></div>
</div>
<div class="card note small">Payouts: approved withdrawals are paid outside this system (bank transfer/UPI). Integrate a proper payment gateway such as Razorpay Payouts later. Member-to-member transfers are intentionally not supported (would require an RBI licence).</div>
<%- include('../partials/footer') %>
