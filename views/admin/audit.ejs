<%- include('../partials/header') %>
<div class="page-title"><h1>Audit log</h1></div>
<div class="card"><div class="table-wrap"><table class="table"><thead><tr><th>#</th><th>Time</th><th>By</th><th>Action</th><th>Member</th><th>Details</th></tr></thead><tbody>
<% rows.forEach(l => { %><tr><td><%= l.id %></td><td class="small nowrap"><%= fmtDate(l.created_at) %></td><td><%= l.admin %><% if (l.admin_role === 'manager') { %><br><span class="small muted">Approval Manager</span><% } %></td><td><b><%= l.action.replace(/_/g,' ') %></b></td><td class="small"><%= l.target || '' %><br><span class="muted"><%= l.target_email || '' %></span></td><td class="small"><%= l.details %></td></tr><% }) %>
<% if (!rows.length) { %><tr><td colspan="6" class="muted">No entries.</td></tr><% } %>
</tbody></table></div></div>
<%- include('../partials/footer') %>
