<%- include('../partials/header') %>
<div class="page-title"><h1>Withdrawal requests</h1></div>
<div class="card note small" id="payout-note"><b>Pay the member from your PayPal/bank first, then enter the transaction ID here. The site does not send money itself.</b><br>For Bank/UPI enter the <b>UTR</b>; for PayPal enter the <b>PayPal transaction ID</b>. Pay only to the member's own account shown below. Rejecting returns the held amount to the member's wallet.</div>
<div class="card"><div class="table-wrap"><table class="table"><thead><tr><th>#</th><th>Date</th><th>Member</th><th class="r">Amount</th><th>Payout method</th><th>Status</th><th>Action</th></tr></thead><tbody>
<% rows.forEach(w => { const pp = w.payout_method === 'paypal'; %><tr data-wid="<%= w.id %>">
  <td><%= w.id %></td><td class="small"><%= fmtDate(w.created_at) %></td><td><%= w.member %><br><span class="small muted"><%= w.member_uid %> · <%= w.email %></span></td><td class="r"><%= inr(w.amount_paise) %></td>
  <td class="small"><b class="wd-method"><%= pp ? 'PayPal' : 'Bank / UPI' %></b><br><% if (pp) { %>PayPal email: <span class="wd-paypal"><%= w.paypal_email %></span><% } else { %><%= w.payout_details %><% } %><br>Country: <span class="wd-country"><%= w.country %></span></td>
  <td><span class="pill <%= w.status==='approved'?'paid':w.status==='rejected'?'cancelled':'pending' %>"><%= w.status %></span><% if (w.processed_at) { %><br><span class="small muted"><%= w.admin %><%= w.admin_role==='manager' ? ' (manager)' : '' %> · <%= fmtDate(w.processed_at) %><br><%= w.admin_note %></span><% } %></td>
  <td><% if (w.status==='pending') { %><form method="post" action="/admin/withdrawals/<%= w.id %>" class="wdform"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <label class="small"><%= pp ? 'PayPal transaction ID' : 'UTR' %><input name="reference" maxlength="300" placeholder="<%= pp ? 'PayPal transaction ID' : 'UTR number' %>" autocomplete="off"></label>
    <button name="action" value="approve" class="btn btn-sm btn-gold">Approve</button>
    <label class="small">Reject reason<input name="reason" maxlength="300" placeholder="Reason (if rejecting)" autocomplete="off"></label>
    <button name="action" value="reject" class="btn btn-sm btn-danger">Reject</button></form><% } %></td>
</tr><% }) %>
<% if (!rows.length) { %><tr><td colspan="7" class="muted">No requests.</td></tr><% } %>
</tbody></table></div></div>
<%- include('../partials/footer') %>
